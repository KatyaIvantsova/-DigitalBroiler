# Шаблон .env для сервера (лежит рядом с deploy.yml, в git не коммитится).
# Сгенерировать случайные значения: openssl rand -base64 32

POSTGRES_DB=broiler_monitoring
POSTGRES_USER=broiler
POSTGRES_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

INCIDENT_ATTACHMENTS_S3_ACCESS_KEY=broiler
INCIDENT_ATTACHMENTS_S3_SECRET_KEY=

# Не короче 32 символов. Смена секрета разлогинит всех пользователей.
AUTH_JWT_SECRET=
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Ключ для датчиков и шлюзов (заголовок X-Api-Key)
TELEMETRY_INGEST_API_KEY=

# true — когда сайт работает по HTTPS
AUTH_COOKIE_SECURE=false

# Пусто на проде; demo — накатить демо-инциденты (только для стенда показов)
SPRING_PROFILES_ACTIVE=
