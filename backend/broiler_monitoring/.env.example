# Локальная разработка. Скопируйте в .env и при желании поменяйте значения.
# Файл .env не коммитится. На сервере значения задаются в .env рядом с deploy.yml.

# Профиль demo накатывает демо-инциденты и уведомления (db/demo)
SPRING_PROFILES_ACTIVE=demo

POSTGRES_DB=broiler_monitoring
POSTGRES_USER=broiler_user
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5434

INFLUXDB_DB=broiler_telemetry

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local

INCIDENT_ATTACHMENTS_S3_ENDPOINT=http://localhost:9000
INCIDENT_ATTACHMENTS_S3_REGION=us-east-1
INCIDENT_ATTACHMENTS_S3_BUCKET=broiler-incident-attachments
INCIDENT_ATTACHMENTS_S3_ACCESS_KEY=broiler-local
INCIDENT_ATTACHMENTS_S3_SECRET_KEY=change-me-local
INCIDENT_ATTACHMENTS_S3_PATH_STYLE_ACCESS=true
INCIDENT_ATTACHMENTS_MAX_FILE_SIZE=300MB
INCIDENT_ATTACHMENTS_MAX_REQUEST_SIZE=900MB
INCIDENT_ATTACHMENTS_MAX_FILE_SIZE_BYTES=314572800

# Аутентификация: секрет подписи JWT (не короче 32 символов) и первый администратор.
# Администратор создаётся при старте, если пользователя с таким логином ещё нет.
AUTH_JWT_SECRET=local-dev-secret-change-me-at-least-32-chars
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-local

# Ключ, с которым датчики и шлюзы шлют телеметрию (заголовок X-Api-Key)
TELEMETRY_INGEST_API_KEY=local-ingest-key
